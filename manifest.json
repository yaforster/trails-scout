{
  "manifest_version": 3,
  "name": "Trails Inspector",
  "version": "0.1.0",
  "permissions": ["activeTab", "scripting", "tabs", "storage"],
  "host_permissions": ["http://*/*", "https://*/*"],
  "action": {
    "default_popup": "src/popup/index.html"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/content-inspector.ts"],
      "run_at": "document_idle"
    }
  ]
}
