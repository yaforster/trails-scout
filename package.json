{
  "name": "trails-scout",
  "version": "1.0.0",
  "description": "An extension designed to identify locators of website elements for use in the trails platform.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:firefox": "vite build --mode firefox",
    "preview": "vite preview",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "lucide": "^1.14.0",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@crxjs/vite-plugin": "^2.0.0",
    "@types/firefox-webext-browser": "^143.0.0",
    "@types/webextension-polyfill": "^0.12.5",
    "@vitest/coverage-v8": "^4.1.6",
    "jsdom": "^29.1.1",
    "prettier": "^3.8.3",
    "typescript": "^5.5.3",
    "vite": "^6.0.0",
    "vitest": "^4.0.8"
  },
  "overrides": {
    "@crxjs/vite-plugin": {
      "rollup": "2.80.0"
    },
    "vite": {
      "rollup": "4.60.3"
    }
  },
  "private": true,
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || >=24.0.0"
  }
}
